<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nextcloud sync (dev_plan.md §10, FR-S1/FR-S2): the first network access this app makes at
         all, everything before it being local-file-only (SAF import/export). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Taking a receipt photo goes through the system camera app (ACTION_IMAGE_CAPTURE), which
         needs no CAMERA permission of ours; the gallery goes through the system photo picker. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>

    <application
        android:label="Kalita"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Kalita"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kalita.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Lets the system camera write a receipt photo into our cache (TakePicture contract). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
