# Same content as packaging/linux/kalita.desktop (the AppImage's own), except Exec=kalita: the
# .deb installs the launcher at /usr/bin/kalita (lowercase, Debian convention), not /usr/bin/Kalita.
[Desktop Entry]
Type=Application
Name=Kalita
Comment=Family budget, compatible with X-Cash's Data.mdb
Exec=kalita
Icon=kalita
Categories=Office;Finance;
Terminal=false
