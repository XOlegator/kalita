#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Oleg Ekhlakov <o.ekhlakov@protonmail.com>
# SPDX-License-Identifier: GPL-3.0-only

# Kalita's .deb compiles nothing on the builder. What `dpkg-buildpackage -S` packages as
# "source" here is not git source — it is the already-built `assembleAppDir` output
# (`./gradlew :modules:app-desktop:assembleAppDir -PbundledQtDir=...`), produced in GitHub
# Actions, where network access to Maven Central / Qt's CDN is available. Launchpad's own
# builders run with network access to the Ubuntu archive only, which this project's Gradle/
# QtJambi build cannot work with (see dev_plan.md §13.4 and the PPA workflow's own comments
# for the full reasoning — this mirrors how the sibling pinba_engine/pinba_extension projects
# use ppa-build.yml, except those really do compile from source on Launchpad, because their
# Build-Depends are all satisfiable from the Ubuntu archive and Kalita's aren't).
#
# So: override_dh_auto_build/_test are no-ops, and override_dh_auto_install just installs the
# prebuilt tree debhelper's normal way. CURDIR at this point is the extracted orig tree, whose
# top level *is* an assembleAppDir AppDir (usr/, AppRun, kalita.desktop, kalita.png) — see the
# PPA workflow for how that tree is assembled into an orig tarball.

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	mkdir -p debian/kalita/usr/lib/kalita
	cp -a usr/. debian/kalita/usr/lib/kalita/usr/
	install -D -m 0755 debian/kalita-wrapper.sh debian/kalita/usr/bin/kalita
	install -D -m 0644 debian/kalita.desktop debian/kalita/usr/share/applications/kalita.desktop
	install -D -m 0644 kalita.png debian/kalita/usr/share/pixmaps/kalita.png

# The bundled Qt/ICU .so files live under a private directory (usr/lib/kalita/usr/lib), never
# the shared linker search path, precisely so they never shadow or conflict with a system Qt —
# -l points dh_shlibdeps at them so *internal* references (Qt plugins needing Qt core, etc.)
# resolve without error, while genuinely external libraries (libc, libX11, fontconfig, the xcb
# family — assembleAppDir's own comment lists what it deliberately does not bundle) still come
# from the normal system search path and still produce correct ${shlibs:Depends} entries.
#
# --ignore-missing-info: libqxcb.so (our bundled xcb platform plugin) needs libQt6XcbQpa.so.6 —
# a private Qt Platform Abstraction library that *is* shipped by Ubuntu's libqt6gui6 (confirmed
# via `dpkg -S`), but that package's own shlibs/symbols deliberately don't cover it (checked
# against noble/resolute's actual package: `cat /var/lib/dpkg/info/libqt6gui6:amd64.shlibs` lists
# only libQt6Gui itself; `grep XcbQpa .../libqt6gui6:amd64.symbols` is empty) — it's QPA-private,
# never meant for anything outside Qt's own plugin loader to link against, so no package anywhere
# publishes a usable dependency for it, hence "no dependency information found"
# (run 33901467/33901468, recurring identically in 0.1.32's resolute/amd64v3 build).
#
# We previously tried `-xlibqt6gui6` here (#82), reasoning the library belongs to that package
# and we didn't want its Depends anyway. That doesn't work: per dpkg-shlibdeps(1), `-x` only
# drops a package from the *generated* dependency list after resolution succeeds — it does
# nothing for the "no dependency information found" failure, which happens earlier, during
# resolution itself. 0.1.32 still carried `-xlibqt6gui6` and hit the exact same error
# (buildlog_ubuntu-resolute-amd64v3.kalita_0.1.32-1~resolute1), proving this empirically.
# `--ignore-missing-info` is the flag dpkg-shlibdeps(1) documents for exactly this case: it
# downgrades "no dependency information found" from a hard error to a warning instead. We accept
# the documented downside (it also silently tolerates a genuinely missing shlibs/symbols entry
# for any *other* library dh_shlibdeps finds) because this package already tolerates equivalent
# gaps for the bundled JRE's internal libs as plain warnings (libjvm.so, libawt.so, etc., just
# above in the same dh_shlibdeps run) — none of those are meant to produce a system Depends
# either; our own bundled Qt (ADR-0008) satisfies this at runtime via LD_LIBRARY_PATH, same as
# every other internal Qt-to-Qt reference here.
# The three wayland-* plugin dirs (assembleAppDir's bundled Qt client-side Wayland support,
# kalita.packaging.gradle.kts) are listed here for the same reason platforms/ already was: every
# ELF file debhelper finds anywhere under debian/kalita gets scanned, plugins included, so their
# private library directories need to be on dpkg-shlibdeps's search path too.
#
# control's libwayland-dev Build-Depends (not used by anything that actually compiles here —
# override_dh_auto_build is a no-op) exists purely so this step's chroot has libwayland-cursor0/
# libwayland-egl1 installed: 0.1.38's noble build failed outright (not a warning — a hard "cannot
# find library") because the bundled libQt6WaylandClient.so's own NEEDED entries
# (libwayland-cursor.so.0, libwayland-egl.so.1 — assembleAppDir's own comment lists both as
# "assumed present on any Linux desktop", i.e. deliberately not bundled, same as libX11/the xcb
# family) weren't in the chroot at all. That part is fixed and stayed fixed.
#
# 0.1.42's noble build hit a *second*, different cause of the exact same symptom ("cannot find
# library libQt6WaylandClient.so.6", needed by platforms/libqwayland.so and the three wayland-*
# plugins) even with libwayland-dev installed: `qt6-base-dev` (below) is itself a Build-Depends,
# and on noble specifically it transitively installs the *system* Qt 6 (6.4.2) — including
# `libqt6waylandclient6`, which `dpkg -S` confirms owns the exact same SONAME as our bundled,
# much newer 6.10.2 copy — a real, confirmed collision risk (local dpkg-shlibdeps run against the
# published 0.1.42 orig tarball), not fully disproven since.
#
# 0.1.44 tried to fix that by running `apt-get remove` on the system Qt 6 packages right here,
# before dh_shlibdeps. That is wrong and has been reverted: `Rules-Requires-Root: no` (control)
# means `debian/rules binary` runs genuinely unprivileged on Launchpad's builders (not even
# fakeroot), so `apt-get remove` can never touch /var/lib/dpkg's lock — confirmed identically on
# both noble and resolute buildlogs for 0.1.44 ("E: Could not open lock file ... Permission
# denied", "are you root?", override_dh_shlibdeps Error 100, every single build). Build-Depends
# is installed by sbuild itself, which does run as real root, but *before* the unprivileged build
# starts — so a real fix for the 0.1.42 collision has to live there (e.g. not Build-Depending on
# qt6-base-dev at all, replacing it with the handful of non-Qt runtime packages it currently pulls
# in for us), not inside override_dh_shlibdeps.
#
# Reverted to the pre-0.1.44 form for now rather than shipping another untested guess: whether the
# 0.1.42 collision still reproduces on a real Launchpad noble build with today's bundled Qt/plugin
# set is genuinely unverified (that investigation was a local dpkg-shlibdeps run, not a live
# rebuild) — fix it from real buildlog evidence if/when it recurs.
override_dh_shlibdeps:
	dh_shlibdeps -l debian/kalita/usr/lib/kalita/usr/lib:debian/kalita/usr/lib/kalita/usr/lib/qt-plugins/platforms:debian/kalita/usr/lib/kalita/usr/lib/qt-plugins/wayland-decoration-client:debian/kalita/usr/lib/kalita/usr/lib/qt-plugins/wayland-shell-integration:debian/kalita/usr/lib/kalita/usr/lib/qt-plugins/wayland-graphics-integration-client -- --ignore-missing-info
